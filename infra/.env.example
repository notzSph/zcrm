POSTGRES_DB=zcrm
POSTGRES_USER=zcrm
POSTGRES_PASSWORD=replace-with-a-long-random-password

ADMIN_EMAIL=admin@example.com
# Generate with: cd apps/api && python -m app.scripts.hash_password
ADMIN_PASSWORD_HASH=
# Legacy admin credentials are migrated into the first zCRM user on startup.
DEFAULT_BUSINESS_NAME=zSpinach
JAYZOO_API_KEY=replace-with-a-long-random-api-key
# Optional scoped CAIO agent key.
CAIO_API_KEY=replace-with-a-long-random-caio-api-key
CAIO_BUSINESS_ID=replace-with-yepa-business-uuid

NEXT_PUBLIC_APP_NAME=zCRM
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3200

# Password reset email delivery. Leave unset only for local development.
PUBLIC_APP_URL=http://localhost:3200
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
